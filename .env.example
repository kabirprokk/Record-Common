# Supabase project URL and publishable/anon key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Supabase secret API key (or legacy service-role key).
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Cloudinary signed uploads. Keep the API secret server-side.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=your-signed-video-preset

# Required Cloudflare Worker upload relay URL, ending in /upload. Uploads stay
# disabled until set; Cloudinary then receives the relay's IP, not the
# contributor's IP.
UPLOAD_RELAY_URL=

# Moderator login. Use a unique, high-entropy password and a random secret of at least 32 characters.
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional public address for rights, removal, and safety reports.
NEXT_PUBLIC_CONTACT_EMAIL=archive-team@example.org
